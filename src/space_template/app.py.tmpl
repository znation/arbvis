import os
from fastapi import FastAPI, Response
from fastapi.responses import FileResponse
from huggingface_hub import HfFileSystem
from huggingface_hub.errors import EntryNotFoundError

BUCKET_ID = "__BUCKET_ID__"

app = FastAPI()
_fs = None


def fs():
    global _fs
    if _fs is None:
        _fs = HfFileSystem(token=os.environ.get("HF_TOKEN"))
    return _fs


@app.get("/")
def index():
    return FileResponse("index.html")


@app.get("/labels.json")
def labels():
    data = fs().read_bytes(f"hf://buckets/{BUCKET_ID}/labels.json")
    return Response(content=data, media_type="application/json")


_TILE_MEDIA_TYPES = {
    "avif": "image/avif",
    "png": "image/png",
    "webp": "image/webp",
}


@app.get("/tiles/{z}/{x}/{y_ext}")
def tile(z: int, x: int, y_ext: str):
    path = f"hf://buckets/{BUCKET_ID}/tiles/{z}/{x}/{y_ext}"
    try:
        data = fs().read_bytes(path)
    except (FileNotFoundError, EntryNotFoundError):
        return Response(status_code=404)
    ext = y_ext.rsplit(".", 1)[-1].lower() if "." in y_ext else ""
    media_type = _TILE_MEDIA_TYPES.get(ext, "application/octet-stream")
    return Response(content=data, media_type=media_type)
