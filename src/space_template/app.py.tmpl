import gzip
import os
import re
import tempfile
import threading
from fastapi import FastAPI, Request, Response
from fastapi.responses import FileResponse, StreamingResponse
from huggingface_hub import HfFileSystem
from huggingface_hub.errors import EntryNotFoundError

BUCKET_ID = "__BUCKET_ID__"

# Single-range "bytes=start-end" (either bound optional). Multi-range requests
# fall through to a normal 200 — the 3D viewer only issues single ranges.
_RANGE_RE = re.compile(r"bytes=(\d*)-(\d*)")

# Chunk size for streaming whole-file (200) responses. Peak per-request RAM is
# one chunk — never the whole file — so a multi-GB brick pool or coarse grid
# streams through a fixed small buffer instead of being buffered entire (the
# 16 GB OOM the old `read_bytes` path caused on repeated loads).
_CHUNK = 4 * 1024 * 1024

# Ceiling for buffer-then-gzip: only assets at or below this are read whole and
# gzip-compressed in RAM (transient peak ≈ 2× the asset — the raw bytes plus the
# gzip output). Sized so the streamed 3D path's up-front downloads all fit: a
# full-cube coarse `volume.bin` is ~64 MB at the 256³ coarse cap (much smaller
# for the thin, aspect-preserving boxes structured layouts produce), plus
# `tree.bin` and `meta.json`. The large streamed assets (`bricks.bin`,
# `pagetable.bin`) stay above it and stream in fixed chunks uncompressed, so we
# never buffer a multi-GB file whole. ~2× of 100 MB (~200 MB transient) is safe
# because everything big streams instead.
_GZIP_MAX = 100 * 1024 * 1024

# Small, highly-compressible up-front assets worth gzip-ing on the wire when
# under `_GZIP_MAX`. `bricks.bin`/`pagetable.bin` are deliberately excluded — the
# former is fetched by HTTP Range (never compressed, so byte offsets stay valid)
# and both can be large. The browser transparently inflates `Content-Encoding:
# gzip`, so the viewer still reads decompressed bytes and its byte-counted
# progress bar (sized from uncompressed lengths) stays exact.
_GZIP_ASSETS = {"volume.bin", "tree.bin", "meta.json"}

# Bundle assets are immutable per deploy, so it's safe to let the browser cache
# them hard. This is the single biggest lever on rate limiting: with it, a page
# reload and panning back to an already-seen region reuse cached bricks instead
# of re-hitting the Hub through this proxy. Applied to every asset response.
_CACHE_CONTROL = "public, max-age=31536000, immutable"

# Assets fetched by many small HTTP Range requests — the streamed 3D brick pool.
# This is the ONE access pattern that storms the Hub: the viewer issues a Range
# request per brick (thousands per view), and the browser cache only helps on a
# *reload*, never the first load. So we mirror these files to the Space's local
# disk once and serve every subsequent range from disk — turning thousands of
# per-brick Hub round trips into a single background download. bricks.bin can be
# multi-GB, but it lands on ephemeral disk (streamed in fixed chunks, never
# buffered whole in RAM), so there's no OOM. Everything else — the whole-file
# up-front assets and the 2D tiles — is fetched once and needs no mirror.
_MIRROR_ASSETS = {"bricks.bin"}
_MIRROR_DIR = os.path.join(tempfile.gettempdir(), "arbvis_mirror")

# Cap concurrent Hub range reads. It only bites during the brief window before a
# mirror is ready (once local, reads never touch the Hub); there it keeps the
# Space from bursting the Hub into a 429. The client retries with backoff, so a
# small cap merely slows warm-up slightly instead of dropping bricks.
_HUB_SEM = threading.Semaphore(3)

_mirror_lock = threading.Lock()
_mirror_started = set()  # rest-paths whose one-time background download has begun

app = FastAPI()
_fs = None
# Per-process cache of file sizes. Every Range request needs the file size (to
# resolve open-ended/suffix ranges and emit Content-Range), but the sizes never
# change for a given deploy — so fetch each at most once instead of paying a Hub
# metadata call on every brick request.
_size_cache = {}


def fs():
    global _fs
    if _fs is None:
        _fs = HfFileSystem(token=os.environ.get("HF_TOKEN"))
    return _fs


def cached_size(path):
    size = _size_cache.get(path)
    if size is None:
        size = fs().size(path)  # may raise FileNotFoundError/EntryNotFoundError
        _size_cache[path] = size
    return size


def _mirror_ready(rest):
    """Local mirror path for `rest` if the full download has landed, else None.
    Only the final path exists once the download is complete (see `_start_mirror`
    — it writes to `.part` and atomically renames), so its presence means the
    file is whole and safe to serve ranges from."""
    dst = os.path.join(_MIRROR_DIR, rest)
    return dst if os.path.exists(dst) else None


def _start_mirror(rest):
    """Kick off (at most once) a background download of `rest` to local disk.

    Streams to a `.part` file in fixed chunks — peak RAM is one chunk, never the
    whole multi-GB file — then atomically renames so readers only ever see a
    complete file. A missing asset (e.g. a 2D bundle has no bricks.bin) or a
    transient failure clears the marker so a later request can retry, and serving
    falls back to the Hub proxy in the meantime."""
    with _mirror_lock:
        if rest in _mirror_started:
            return
        _mirror_started.add(rest)

    def _run():
        path = f"hf://buckets/{BUCKET_ID}/{rest}"
        dst = os.path.join(_MIRROR_DIR, rest)
        part = dst + ".part"
        try:
            os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
            with fs().open(path, "rb", block_size=0) as src, open(part, "wb") as out:
                while True:
                    chunk = src.read(_CHUNK)
                    if not chunk:
                        break
                    out.write(chunk)
            os.replace(part, dst)  # atomic: readers see the file only when whole
        except Exception:
            try:
                os.remove(part)
            except OSError:
                pass
            with _mirror_lock:
                _mirror_started.discard(rest)

    threading.Thread(target=_run, daemon=True).start()


@app.on_event("startup")
def _prime_mirror():
    # Front-load the brick pool while the user is still watching the coarse
    # volume load, so the mirror is (partly) ready by the time bricks stream.
    for rest in _MIRROR_ASSETS:
        _start_mirror(rest)


@app.get("/")
def index():
    return FileResponse("index.html")


_MEDIA_TYPES = {
    "avif": "image/avif",
    "png": "image/png",
    "webp": "image/webp",
    "json": "application/json",
    "bin": "application/octet-stream",
    "html": "text/html",
    "js": "text/javascript",
    "css": "text/css",
}


# Serve any bundle asset from the backing bucket. This single catch-all covers
# the 2D layout (tiles/<z>/<x>/<y>.<ext>, the multi-scene tiles/<scene>/...,
# and labels.json) and the 3D bundle (volume.bin, bricks.bin, pagetable.bin,
# meta.json). HTTP Range is honored so the 3D viewer can stream one brick at a
# time instead of the whole bricks.bin — range reads pull only the requested
# bytes from the Hub.
@app.get("/{rest:path}")
def asset(rest: str, request: Request):
    if not rest or rest == "index.html":
        return FileResponse("index.html")
    path = f"hf://buckets/{BUCKET_ID}/{rest}"
    ext = rest.rsplit(".", 1)[-1].lower() if "." in rest else ""
    media_type = _MEDIA_TYPES.get(ext, "application/octet-stream")

    range_header = request.headers.get("range")
    m = _RANGE_RE.fullmatch(range_header.strip()) if range_header else None
    if m:
        try:
            size = cached_size(path)
        except (FileNotFoundError, EntryNotFoundError):
            return Response(status_code=404)
        start_s, end_s = m.group(1), m.group(2)
        if start_s == "":
            # Suffix range "bytes=-N": the last N bytes.
            start = max(0, size - int(end_s)) if end_s else 0
            end = size - 1
        else:
            start = int(start_s)
            end = int(end_s) if end_s else size - 1
        if start >= size or start > end:
            return Response(status_code=416, headers={"Content-Range": f"bytes */{size}"})
        end = min(end, size - 1)
        # Once the local mirror has landed, serve the range straight off disk —
        # zero Hub traffic, so the brick storm can't rate-limit us. Until then
        # (and for non-mirrored assets), proxy to the Hub, but ensure the mirror
        # is downloading and pace concurrent Hub reads through the semaphore.
        local = _mirror_ready(rest) if rest in _MIRROR_ASSETS else None
        try:
            if local:
                with open(local, "rb") as f:
                    f.seek(start)
                    chunk = f.read(end - start + 1)
            else:
                if rest in _MIRROR_ASSETS:
                    _start_mirror(rest)
                with _HUB_SEM:
                    with fs().open(path, "rb") as f:
                        f.seek(start)
                        chunk = f.read(end - start + 1)
        except (FileNotFoundError, EntryNotFoundError):
            return Response(status_code=404)
        return Response(
            content=chunk,
            status_code=206,
            media_type=media_type,
            headers={
                "Content-Range": f"bytes {start}-{end}/{size}",
                "Accept-Ranges": "bytes",
                "Content-Length": str(len(chunk)),
                "Cache-Control": _CACHE_CONTROL,
            },
        )

    try:
        size = cached_size(path)
    except (FileNotFoundError, EntryNotFoundError):
        return Response(status_code=404)

    # Small, compressible up-front asset the client accepts gzip for: read it
    # once (bounded by `_GZIP_MAX`) and compress in RAM. Safe because these are
    # small by construction; the browser inflates transparently so the viewer's
    # uncompressed-byte progress stays exact.
    accepts_gzip = "gzip" in request.headers.get("accept-encoding", "")
    if rest in _GZIP_ASSETS and size <= _GZIP_MAX and accepts_gzip:
        try:
            with fs().open(path, "rb", block_size=0) as f:
                data = f.read()
        except (FileNotFoundError, EntryNotFoundError):
            return Response(status_code=404)
        data = gzip.compress(data, compresslevel=6)
        return Response(
            content=data,
            media_type=media_type,
            headers={
                "Accept-Ranges": "bytes",
                "Content-Encoding": "gzip",
                "Vary": "Accept-Encoding",
                "Cache-Control": _CACHE_CONTROL,
            },
        )

    # Everything else (the multi-GB brick pool, the page table, 2D tiles,
    # labels.json, and a defensively-large volume.bin) streams in fixed chunks so
    # peak RAM is one `_CHUNK`, never the whole file — and nothing accumulates
    # across requests (the stream file uses `cache_type="none"`).
    def body():
        with fs().open(path, "rb", block_size=0) as f:
            while True:
                chunk = f.read(_CHUNK)
                if not chunk:
                    break
                yield chunk

    return StreamingResponse(
        body(),
        media_type=media_type,
        headers={
            "Accept-Ranges": "bytes",
            "Content-Length": str(size),
            "Cache-Control": _CACHE_CONTROL,
        },
    )
